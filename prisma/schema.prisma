// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

//refer docs: https://www.prisma.io/docs
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Birthday {
  id     String @id @default(uuid())
  day    Int
  month  Int
  name   String
  title  String
  userId String
}
